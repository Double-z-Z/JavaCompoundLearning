<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <parent>
       <groupId>org.springframework.boot</groupId>
       <artifactId>spring-boot-starter-parent</artifactId>
       <version>3.2.3</version>
       <relativePath/>
   </parent>

   <groupId>com.devops</groupId>
   <artifactId>devops-dashboard</artifactId>
   <version>1.0.0-SNAPSHOT</version>
   <name>DevOps Dashboard</name>
   <description>DevOps控制面板 - 环境管理、实验平台、流水线编排</description>

   <!--
   ════════════════════════════════════════════════════════════════════
   DevOps Dashboard - Phase 1 配置说明
   
   技术栈: Spring Boot 3.2.3 + WebFlux + JPA + PostgreSQL
   构建工具: Maven 3.x
   Java版本: 17 (LTS)
   
   ⚠️ 重要配置决策:
   1. 使用 WebFlux (Netty) 而非 WebMVC (Tomcat) - 见 Decision 7
   2. 排除所有 Tomcat 相关依赖（见下方 exclusions）
   3. Enforcer Plugin 防止 Tomcat 复发（构建时自动检测）
   4. JPA 集合字段使用 EAGER 加载（WebFlux 异步兼容性要求）
   
   详细文档:
   - 设计决策: docs/design-decisions.md
   - API指南: docs/api-guide.md
   - Phase 1总结: docs/phase1-completion-report.md
   ════════════════════════════════════════════════════════════════════
   -->

   <properties>
       <java.version>17</java.version>
       <maven.compiler.source>17</maven.compiler.source>
       <maven.compiler.target>17</maven.compiler.target>
       <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
       
       <!-- 依赖版本管理 -->
       <spring-cloud.version>2023.0.0</spring-cloud.version>
       <lombok.version>1.18.30</lombok.version>
       <mapstruct.version>1.5.5.Final</mapstruct.version>
   </properties>

   <dependencies>
       <!-- ============================================================
            核心框架: Spring Boot WebFlux (响应式编程)
            
            为什么选 WebFlux?
            - Decision 7: 学习响应式范式，为高并发做准备
            - Netty 比 Tomcat 更轻量，资源占用更低
            - 与 Project Reactor 天然集成
            
            注意: 必须排除所有 Tomcat/Servlet 依赖！
            否则会回退到 WebMVC 模式
            ============================================================ -->
       <dependency>
           <groupId>org.springframework.boot</groupId>
           <artifactId>spring-boot-starter-webflux</artifactId>
       </dependency>
       
       <!-- ============================================================
            数据持久层: JPA + Hibernate
            
            ⚠️ 关键: 排除 spring-boot-starter-tomcat
            原因: data-jpa 默认引入 Tomcat（用于 Servlet 容器）
            但我们使用 Netty，必须手动排除
            ============================================================ -->
       <dependency>
           <groupId>org.springframework.boot</groupId>
           <artifactId>spring-boot-starter-data-jpa</artifactId>
           <exclusions>
               <exclusion>
                   <!-- 排除原因: data-jpa → jdbc → tomcat-jdbc → tomcat -->
                   <groupId>org.springframework.boot</groupId>
                   <artifactId>spring-boot-starter-tomcat</artifactId>
               </exclusion>
           </exclusions>
       </dependency>
       
       <!-- ============================================================
            参数校验: Bean Validation
            
            ⚠️ 排除 tomcat-embed-el (EL表达式解析器)
            原因: validation 依赖 Tomcat 的 EL 实现
            替代方案: 使用独立 EL 库或自定义 Validator
            当前影响: 仅影响复杂校验表达式，基础@NotNull/@NotBlank正常工作
            ============================================================ -->
       <dependency>
           <groupId>org.springframework.boot</groupId>
           <artifactId>spring-boot-starter-validation</artifactId>
           <exclusions>
               <exclusion>
                   <groupId>org.apache.tomcat.embed</groupId>
                   <artifactId>tomcat-embed-el</artifactId>
               </exclusion>
           </exclusions>
       </dependency>

       <!-- ============================================================
            WebSocket 支持 (Phase 3 日志流功能预留)
            
            ⚠️⚠️⚠️ 最隐蔽的 Tomcat 来源!
            排除原因: websocket starter 引入整个 WebMVC 栈
            传递路径: 
              websocket → web → servlet-api → tomcat-embed-core
              
            这是 Phase 1 遇到的最棘手的依赖问题，
            花了 2小时才用 `mvn dependency:tree` 定位到！
            ============================================================ -->
       <dependency>
           <groupId>org.springframework.boot</groupId>
           <artifactId>spring-boot-starter-websocket</artifactId>
           <exclusions>
               <exclusion>
                   <groupId>org.springframework.boot</groupId>
                   <artifactId>spring-boot-starter-web</artifactId>
               </exclusion>
           </exclusions>
       </dependency>

       <!-- 数据库驱动 -->
       <dependency>
           <groupId>org.postgresql</groupId>
           <artifactId>postgresql</artifactId>
           <scope>runtime</scope>
       </dependency>
       
       <!-- H2 内存数据库 (仅测试用) -->
       <dependency>
           <groupId>com.h2database</groupId>
           <artifactId>h2</artifactId>
           <scope>test</scope>
       </dependency>

       <!-- Lombok: 减少样板代码 (Getter/Setter/Builder) -->
       <dependency>
           <groupId>org.projectlombok</groupId>
           <artifactId>lombok</artifactId>
           <version>${lombok.version}</version>
           <optional>true</optional>
       </dependency>

       <!-- MapStruct: 对象映射框架 (DTO ↔ Domain) -->
       <dependency>
           <groupId>org.mapstruct</groupId>
           <artifactId>mapstruct</artifactId>
           <version>${mapstruct.version}</version>
       </dependency>

       <!-- 测试依赖 -->
       <dependency>
           <groupId>org.springframework.boot</groupId>
           <artifactId>spring-boot-starter-test</artifactId>
           <scope>test</scope>
       </dependency>
       
       <!-- Reactor Test: 测试 Mono/Flux 响应式类型 -->
       <dependency>
           <groupId>io.projectreactor</groupId>
           <artifactId>reactor-test</artifactId>
           <scope>test</scope>
       </dependency>

       <!-- ================================================================
            API 文档: Swagger/OpenAPI 3.0
            
            版本选择: springdoc-openapi-starter-**webflux**-ui
            ❌ 不能用 webmvc-ui 版本（会启动 Tomcat DispatcherServlet）
            ✅ 必须用 webflux-ui 版本（使用 WebFlux RouterFunction）
            
            访问地址: http://localhost:8080/swagger-ui.html
            文档JSON: http://localhost:8080/v3/api-docs
            ================================================================ -->
       <dependency>
           <groupId>org.springdoc</groupId>
           <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
           <version>2.3.0</version>
       </dependency>

       <!-- 工具库 -->
       <dependency>
           <groupId>org.apache.commons</groupId>
           <artifactId>commons-lang3</artifactId>
       </dependency>
   </dependencies>

   <build>
       <plugins>
           <!-- ================================================================
                Maven Enforcer Plugin: 依赖安全网关
                
                功能: 构建时自动检测是否引入了禁止的依赖
                
                为什么需要?
                - Phase 1 经历过 "Tomcat 打地鼠" 问题
                - 新增依赖可能间接引入 Tomcat（如新加一个 Starter）
                - Enforcer 能在编译前就拦截，避免运行时才发现
                
                触发条件:
                - 任何依赖传递性引入了:
                  * spring-boot-starter-tomcat
                  * org.apache.tomcat.embed:* (core, el, websocket)
                  
                错误信息示例:
                [ERROR] Rule 0: bannedDependencies failed with message:
                🚫 项目使用 WebFlux (Netty)，禁止 Tomcat！请检查新加入的依赖。
                
                解决方法:
                1. 运行 `mvn dependency:tree -Dverbose` 查找来源
                2. 在对应依赖中添加 <exclusion>
                3. 重新构建
                ================================================================ -->
           <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-enforcer-plugin</artifactId>
               <version>3.4.1</version>
               <executions>
                   <execution>
                       <id>enforce-no-tomcat</id>
                       <phase>validate</phase>  <!-- 在编译前执行 -->
                       <goals><goal>enforce</goal></goals>
                       <configuration>
                           <rules>
                               <bannedDependencies>
                                   <excludes>
                                       <exclude>org.springframework.boot:spring-boot-starter-tomcat</exclude>
                                       <exclude>org.apache.tomcat.embed:*</exclude>
                                   </excludes>
                                   <message>🚫 项目使用 WebFlux (Netty)，禁止 Tomcat！请检查新加入的依赖。执行 `mvn dependency:tree | grep tomcat` 定位来源。</message>
                               </bannedDependencies>
                           </rules>
                       </configuration>
                   </execution>
               </executions>
           </plugin>
           
           <!-- Spring Boot Maven Plugin: 打包可执行 JAR -->
           <plugin>
               <groupId>org.springframework.boot</groupId>
               <artifactId>spring-boot-maven-plugin</artifactId>
               <configuration>
                   <excludes>
                       <exclude>
                           <groupId>org.projectlombok</groupId>
                           <artifactId>lombok</artifactId>
                       </exclude>
                   </excludes>
               </configuration>
           </plugin>
           
           <!-- Compiler Plugin: 注解处理器配置 -->
           <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-compiler-plugin</artifactId>
               <configuration>
                   <annotationProcessorPaths>
                       <!-- Lombok: 编译时生成 Getter/Setter/Builder -->
                       <path>
                           <groupId>org.projectlombok</groupId>
                           <artifactId>lombok</artifactId>
                           <version>${lombok.version}</version>
                       </path>
                       <!-- MapStruct: 编译时生成 Mapper 实现 -->
                       <path>
                           <groupId>org.mapstruct</groupId>
                           <artifactId>mapstruct-processor</artifactId>
                           <version>${mapstruct.version}</version>
                       </path>
                   </annotationProcessorPaths>
               </configuration>
           </plugin>
       </plugins>
   </build>

</project>
