<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.order.infrastructure.persistence.sharding.ShardOrderMapper">

    <!-- ================================================================ -->
    <!-- 1. <sql> + <include>: SQL 片段复用                              -->
    <!-- ================================================================ -->
    <sql id="orderColumns">
        o.id, o.user_id, o.order_no, o.total_amount, o.status, o.created_at
    </sql>

    <select id="selectById" resultType="com.example.order.infrastructure.persistence.sharding.ShardOrder">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        WHERE o.id = #{id}
    </select>

    <!-- ================================================================ -->
    <!-- 2. <where> + <if>: 多条件可选查询 — 自动去掉第一个 AND/OR         -->
    <!-- ================================================================ -->
    <select id="selectByCondition" resultType="com.example.order.infrastructure.persistence.sharding.ShardOrder">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        <where>
            <if test="orderNo != null and orderNo != ''">
                AND o.order_no = #{orderNo}
            </if>
            <if test="status != null and status != ''">
                AND o.status = #{status}
            </if>
            <if test="minAmount != null">
                AND o.total_amount &gt;= #{minAmount}
            </if>
            <if test="maxAmount != null">
                AND o.total_amount &lt;= #{maxAmount}
            </if>
            <if test="userId != null">
                AND o.user_id = #{userId}
            </if>
        </where>
        ORDER BY o.created_at DESC
    </select>

    <!-- ================================================================ -->
    <!-- 3. <choose>/<when>/<otherwise>: 互斥分支                        -->
    <!-- ================================================================ -->
    <select id="selectByPriority" resultType="com.example.order.infrastructure.persistence.sharding.ShardOrder">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        <where>
            <choose>
                <when test="orderNo != null and orderNo != ''">
                    AND o.order_no = #{orderNo}
                </when>
                <when test="status != null and status != ''">
                    AND o.status = #{status}
                </when>
                <when test="userId != null">
                    AND o.user_id = #{userId}
                </when>
                <otherwise>
                    AND o.status = 'PAID'
                </otherwise>
            </choose>
        </where>
    </select>

    <!-- ================================================================ -->
    <!-- 4. <foreach>: IN 查询                                           -->
    <!-- ================================================================ -->
    <select id="selectByIds" resultType="com.example.order.infrastructure.persistence.sharding.ShardOrder">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        WHERE o.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- ================================================================ -->
    <!-- 5. <foreach>: 批量插入                                          -->
    <!-- ================================================================ -->
    <insert id="insertBatch" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO orders (user_id, order_no, total_amount, status) VALUES
        <foreach collection="orders" item="order" separator=",">
            (#{order.userId}, #{order.orderNo}, #{order.totalAmount}, #{order.status})
        </foreach>
    </insert>

    <!-- ================================================================ -->
    <!-- 6. <set> + <if>: 动态更新 — 只更新传入的非 null 字段               -->
    <!-- ================================================================ -->
    <update id="updateDynamic">
        UPDATE orders
        <set>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- ================================================================ -->
    <!-- 7. <trim>: 精细前缀/后缀裁剪                                    -->
    <!-- ================================================================ -->
    <select id="selectByConditionTrim" resultType="com.example.order.infrastructure.persistence.sharding.ShardOrder">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <if test="orderNo != null and orderNo != ''">
                AND o.order_no = #{orderNo}
            </if>
            <if test="status != null and status != ''">
                AND o.status = #{status}
            </if>
            <if test="minAmount != null">
                AND o.total_amount &gt;= #{minAmount}
            </if>
        </trim>
        ORDER BY o.id
    </select>

    <!-- ================================================================ -->
    <!-- 8. <bind>: OGNL 变量绑定 — 安全拼接 LIKE 模式                     -->
    <!--     MySQL 用 CONCAT 替代 PG 的 ||                                -->
    <!-- ================================================================ -->
    <select id="selectByOrderNoLike" resultType="com.example.order.infrastructure.persistence.sharding.ShardOrder">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        WHERE o.order_no LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <!-- ================================================================ -->
    <!-- 9. 聚合查询: 窗口函数 + GROUP BY                                  -->
    <!--     MySQL 不支持 NULLS LAST，去掉                                 -->
    <!-- ================================================================ -->
    <select id="selectUserOrderStats" resultType="map">
        SELECT
            u.username,
            COUNT(o.id) AS order_count,
            COALESCE(SUM(o.total_amount), 0) AS total_spent,
            ROW_NUMBER() OVER (ORDER BY SUM(o.total_amount) DESC) AS rank
        FROM t_user u
        LEFT JOIN orders o ON u.id = o.user_id
        GROUP BY u.id, u.username
        ORDER BY total_spent DESC
    </select>

    <!-- ================================================================ -->
    <!-- 10. 分页: LIMIT + OFFSET（MySQL 语法，PG 兼容）                   -->
    <!-- ================================================================ -->
    <select id="selectPage" resultType="com.example.order.infrastructure.persistence.sharding.ShardOrder">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        ORDER BY o.id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 11. 统计 -->
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM orders
    </select>

    <!-- ================================================================ -->
    <!-- 12. ResultMap — <id>/<result>/<association>/<collection>          -->
    <!-- ================================================================ -->

    <resultMap id="userResult" type="com.example.order.infrastructure.persistence.sharding.ShardUser">
        <id property="id" column="u_id"/>
        <result property="username" column="u_username"/>
        <result property="email" column="u_email"/>
        <result property="phone" column="u_phone"/>
    </resultMap>

    <resultMap id="orderItemResult" type="com.example.order.infrastructure.persistence.sharding.ShardOrderItem">
        <id property="id" column="oi_id"/>
        <result property="orderId" column="oi_order_id"/>
        <result property="userId" column="oi_user_id"/>
        <result property="productName" column="oi_product_name"/>
        <result property="quantity" column="oi_quantity"/>
        <result property="unitPrice" column="oi_unit_price"/>
    </resultMap>

    <resultMap id="orderBase" type="com.example.order.infrastructure.persistence.sharding.ShardOrder">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 12a. <association>: 一对一 — Order → User -->
    <resultMap id="orderWithUser" type="com.example.order.infrastructure.persistence.sharding.ShardOrder"
               extends="orderBase">
        <association property="user" javaType="com.example.order.infrastructure.persistence.sharding.ShardUser"
                     resultMap="userResult"/>
    </resultMap>

    <select id="selectOrderWithUser" resultMap="orderWithUser">
        SELECT
            o.id, o.user_id, o.order_no, o.total_amount, o.status, o.created_at,
            u.id AS u_id, u.username AS u_username, u.email AS u_email, u.phone AS u_phone
        FROM orders o
        LEFT JOIN t_user u ON o.user_id = u.id
        WHERE o.id = #{id}
    </select>

    <!-- 12b. <collection>: 一对多 — Order → List<OrderItem> -->
    <resultMap id="orderWithItems" type="com.example.order.infrastructure.persistence.sharding.ShardOrder"
               extends="orderBase">
        <collection property="items" ofType="com.example.order.infrastructure.persistence.sharding.ShardOrderItem"
                    resultMap="orderItemResult"/>
    </resultMap>

    <select id="selectOrderWithItems" resultMap="orderWithItems">
        SELECT
            o.id, o.user_id, o.order_no, o.total_amount, o.status, o.created_at,
            oi.id AS oi_id, oi.order_id AS oi_order_id, oi.user_id AS oi_user_id,
            oi.product_name AS oi_product_name, oi.quantity AS oi_quantity, oi.unit_price AS oi_unit_price
        FROM orders o
        LEFT JOIN order_items oi ON o.id = oi.order_id
        WHERE o.id = #{id}
        ORDER BY oi.id
    </select>

    <!-- 12c. 完整嵌套: Order → User + List<OrderItem> -->
    <resultMap id="orderFull" type="com.example.order.infrastructure.persistence.sharding.ShardOrder"
               extends="orderBase">
        <association property="user" javaType="com.example.order.infrastructure.persistence.sharding.ShardUser"
                     resultMap="userResult"/>
        <collection property="items" ofType="com.example.order.infrastructure.persistence.sharding.ShardOrderItem"
                    resultMap="orderItemResult"/>
    </resultMap>

    <select id="selectOrderFull" resultMap="orderFull">
        SELECT
            o.id, o.user_id, o.order_no, o.total_amount, o.status, o.created_at,
            u.id AS u_id, u.username AS u_username, u.email AS u_email, u.phone AS u_phone,
            oi.id AS oi_id, oi.order_id AS oi_order_id, oi.user_id AS oi_user_id,
            oi.product_name AS oi_product_name, oi.quantity AS oi_quantity, oi.unit_price AS oi_unit_price
        FROM orders o
        LEFT JOIN t_user u ON o.user_id = u.id
        LEFT JOIN order_items oi ON o.id = oi.order_id
        WHERE o.id = #{id}
        ORDER BY oi.id
    </select>

    <!-- ================================================================ -->
    <!-- 13. 嵌套查询 (Nested Select) — N+1 问题演示                       -->
    <!-- ================================================================ -->
    <resultMap id="orderNestedSelect" type="com.example.order.infrastructure.persistence.sharding.ShardOrder"
               extends="orderBase">
        <association property="user" javaType="com.example.order.infrastructure.persistence.sharding.ShardUser"
                     column="user_id" select="selectUserById"/>
    </resultMap>

    <select id="selectOrderNestedSelect" resultMap="orderNestedSelect">
        SELECT id, user_id, order_no, total_amount, status, created_at
        FROM orders
        WHERE id = #{id}
    </select>

    <select id="selectUserById" resultType="com.example.order.infrastructure.persistence.sharding.ShardUser">
        SELECT id, username, email, phone, created_at
        FROM t_user
        WHERE id = #{id}
    </select>

    <!-- ================================================================ -->
    <!-- 14. 存储过程: MySQL {call ...} 语法                               -->
    <!-- ================================================================ -->
    <update id="callUpdateOrderStatus" statementType="CALLABLE">
        {call sp_update_order_status(#{orderId, mode=IN, jdbcType=BIGINT}, #{newStatus, mode=IN, jdbcType=VARCHAR})}
    </update>

    <!-- ================================================================ -->
    <!-- 15. FOR UPDATE: 悲观锁                                           -->
    <!-- ================================================================ -->
    <select id="selectForUpdate" resultType="com.example.order.infrastructure.persistence.sharding.ShardOrder">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        WHERE o.id = #{id}
        FOR UPDATE
    </select>

</mapper>
