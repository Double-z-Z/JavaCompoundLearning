<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.order.mapper.OrderMapper">

    <!-- ===== <sql> + <include>: 复用列名片段 ===== -->
    <sql id="orderColumns">
        o.id, o.user_id, o.order_no, o.total_amount, o.status, o.created_at
    </sql>

    <!-- ===== 基础查询使用 <include> ===== -->
    <select id="selectById" resultType="com.example.order.model.Order">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        WHERE o.id = #{id}
    </select>

    <!-- ================================================================= -->
    <!-- 核心：<where> + <if> —— 多条件可选查询                             -->
    <!-- <where> 自动去掉第一个多余的 AND/OR                                -->
    <!-- ================================================================= -->
    <select id="selectByCondition" resultType="com.example.order.model.Order">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        <where>
            <if test="orderNo != null and orderNo != ''">
                AND o.order_no = #{orderNo}
            </if>
            <if test="status != null and status != ''">
                AND o.status = #{status}
            </if>
            <if test="minAmount != null">
                AND o.total_amount &gt;= #{minAmount}
            </if>
            <if test="maxAmount != null">
                AND o.total_amount &lt;= #{maxAmount}
            </if>
            <if test="userId != null">
                AND o.user_id = #{userId}
            </if>
        </where>
        ORDER BY o.created_at DESC
    </select>

    <!-- ================================================================= -->
    <!-- <choose>/<when>/<otherwise>: 互斥分支（只命中一个）                  -->
    <!-- ================================================================= -->
    <select id="selectByPriority" resultType="com.example.order.model.Order">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        <where>
            <choose>
                <when test="orderNo != null and orderNo != ''">
                    AND o.order_no = #{orderNo}
                </when>
                <when test="status != null and status != ''">
                    AND o.status = #{status}
                </when>
                <when test="userId != null">
                    AND o.user_id = #{userId}
                </when>
                <otherwise>
                    AND o.status = 'PAID'
                </otherwise>
            </choose>
        </where>
    </select>

    <!-- ================================================================= -->
    <!-- <foreach>: IN 查询                                                -->
    <!-- ================================================================= -->
    <select id="selectByIds" resultType="com.example.order.model.Order">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        WHERE o.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- ================================================================= -->
    <!-- <foreach>: 批量插入                                                -->
    <!-- ================================================================= -->
    <insert id="insertBatch" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO orders (user_id, order_no, total_amount, status) VALUES
        <foreach collection="orders" item="order" separator=",">
            (#{order.userId}, #{order.orderNo}, #{order.totalAmount}, #{order.status})
        </foreach>
    </insert>

    <!-- ================================================================= -->
    <!-- <set> + <if>: 动态更新 —— 只更新传入的非 null 字段                   -->
    <!-- <set> 自动处理尾部逗号                                              -->
    <!-- ================================================================= -->
    <update id="updateDynamic">
        UPDATE orders
        <set>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- ================================================================= -->
    <!-- <trim>: 更精细的前缀/后缀裁剪                                       -->
    <!-- prefix: 加前缀  prefixOverrides: 去掉前缀中多余的 AND/OR           -->
    <!-- suffixOverrides: 去掉尾部多余的逗号                                -->
    <!-- ================================================================= -->
    <select id="selectByConditionTrim" resultType="com.example.order.model.Order">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <if test="orderNo != null and orderNo != ''">
                AND o.order_no = #{orderNo}
            </if>
            <if test="status != null and status != ''">
                AND o.status = #{status}
            </if>
            <if test="minAmount != null">
                AND o.total_amount &gt;= #{minAmount}
            </if>
        </trim>
        ORDER BY o.id
    </select>

    <!-- ================================================================= -->
    <!-- <bind>: OGNL 变量绑定 —— 在 XML 侧拼接 LIKE 模式                     -->
    <!-- 注意: OGNL 中 + 对字符串的支持因版本而异，这里用 SQL 拼接兜底         -->
    <!-- ================================================================= -->
    <select id="selectByOrderNoLike" resultType="com.example.order.model.Order">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        WHERE o.order_no LIKE '%' || #{keyword} || '%'
    </select>

    <!-- ================================================================= -->
    <!-- 聚合查询：窗口函数 + GROUP BY                                    -->
    <!-- ================================================================= -->
    <select id="selectUserOrderStats" resultType="map">
        SELECT
            u.username,
            COUNT(o.id) AS order_count,
            COALESCE(SUM(o.total_amount), 0) AS total_spent,
            ROW_NUMBER() OVER (ORDER BY SUM(o.total_amount) DESC NULLS LAST) AS rank
        FROM users u
        LEFT JOIN orders o ON u.id = o.user_id
        GROUP BY u.id, u.username
        ORDER BY total_spent DESC
    </select>

    <!-- ================================================================= -->
    <!-- 分页：LIMIT + OFFSET                                              -->
    <!-- ================================================================= -->
    <select id="selectPage" resultType="com.example.order.model.Order">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        ORDER BY o.id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- ================================================================= -->
    <!-- 统计                                                              -->
    <!-- ================================================================= -->
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM orders
    </select>

    <!-- ================================================================= -->
    <!-- Phase 3: ResultMap 关联映射                                       -->
    <!-- ================================================================= -->

    <!--
        <id> vs <result>:
        - <id>: 主键字段。MyBatis 用它判断两行是否同一个对象（用于 <collection> 分组）
        - <result>: 普通字段。
    -->

    <!-- 基础 User ResultMap -->
    <resultMap id="userResult" type="com.example.order.model.User">
        <id property="id" column="u_id"/>
        <result property="username" column="u_username"/>
        <result property="email" column="u_email"/>
        <result property="phone" column="u_phone"/>
        <result property="createdAt" column="u_created_at"/>
    </resultMap>

    <!-- 基础 OrderItem ResultMap（含 Product 关联） -->
    <resultMap id="orderItemResult" type="com.example.order.model.OrderItem">
        <id property="id" column="oi_id"/>
        <result property="orderId" column="oi_order_id"/>
        <result property="productId" column="oi_product_id"/>
        <result property="quantity" column="oi_quantity"/>
        <result property="unitPrice" column="oi_unit_price"/>
        <association property="product" javaType="com.example.order.model.Product">
            <id property="id" column="p_id"/>
            <result property="name" column="p_name"/>
            <result property="price" column="p_price"/>
            <result property="stock" column="p_stock"/>
            <result property="category" column="p_category"/>
        </association>
    </resultMap>

    <!-- 基础 Order ResultMap（供关联映射复用） -->
    <resultMap id="orderBase" type="com.example.order.model.Order">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- ================================================================ -->
    <!-- 一对一: <association> — 嵌套结果映射（单条 SQL JOIN）               -->
    <!-- ================================================================ -->
    <resultMap id="orderWithUser" type="com.example.order.model.Order" extends="orderBase">
        <!--
            association: 把关联查询的列映射到一个嵌套 Java 对象
            property: Order 类里的属性名（order.getUser()）
            javaType: 嵌套对象的类型
            resultMap: 复用已有的 User ResultMap
        -->
        <association property="user" javaType="com.example.order.model.User"
                     resultMap="userResult"/>
    </resultMap>

    <select id="selectOrderWithUser" resultMap="orderWithUser">
        SELECT
            o.id, o.user_id, o.order_no, o.total_amount, o.status, o.created_at,
            u.id AS u_id, u.username AS u_username, u.email AS u_email,
            u.phone AS u_phone, u.created_at AS u_created_at
        FROM orders o
        LEFT JOIN users u ON o.user_id = u.id
        WHERE o.id = #{id}
    </select>

    <!-- ================================================================ -->
    <!-- 一对多: <collection> — 嵌套结果映射（单条 SQL JOIN）               -->
    <!-- ================================================================ -->
    <resultMap id="orderWithItems" type="com.example.order.model.Order" extends="orderBase">
        <!--
            collection: 把多行数据聚合成一个 List 属性
            ofType: List 里元素的类型
            关键：<id> 字段用于判断"两行是一个 Order 还是下一个 Order"
        -->
        <collection property="items" ofType="com.example.order.model.OrderItem"
                    resultMap="orderItemResult"/>
    </resultMap>

    <select id="selectOrderWithItems" resultMap="orderWithItems">
        SELECT
            o.id, o.user_id, o.order_no, o.total_amount, o.status, o.created_at,
            oi.id AS oi_id,
            oi.order_id AS oi_order_id,
            oi.product_id AS oi_product_id,
            oi.quantity AS oi_quantity,
            oi.unit_price AS oi_unit_price,
            p.id AS p_id,
            p.name AS p_name,
            p.price AS p_price,
            p.stock AS p_stock,
            p.category AS p_category
        FROM orders o
        LEFT JOIN order_items oi ON o.id = oi.order_id
        LEFT JOIN products p ON oi.product_id = p.id
        WHERE o.id = #{id}
        ORDER BY oi.id
    </select>

    <!-- ================================================================ -->
    <!-- 完整嵌套: Order → User + OrderItem → Product                      -->
    <!-- ================================================================ -->
    <resultMap id="orderFull" type="com.example.order.model.Order" extends="orderBase">
        <association property="user" javaType="com.example.order.model.User"
                     resultMap="userResult"/>
        <collection property="items" ofType="com.example.order.model.OrderItem"
                    resultMap="orderItemResult"/>
    </resultMap>

    <select id="selectOrderFull" resultMap="orderFull">
        SELECT
            o.id, o.user_id, o.order_no, o.total_amount, o.status, o.created_at,
            u.id AS u_id, u.username AS u_username, u.email AS u_email,
            u.phone AS u_phone, u.created_at AS u_created_at,
            oi.id AS oi_id,
            oi.order_id AS oi_order_id,
            oi.product_id AS oi_product_id,
            oi.quantity AS oi_quantity,
            oi.unit_price AS oi_unit_price,
            p.id AS p_id,
            p.name AS p_name,
            p.price AS p_price,
            p.stock AS p_stock,
            p.category AS p_category
        FROM orders o
        LEFT JOIN users u ON o.user_id = u.id
        LEFT JOIN order_items oi ON o.id = oi.order_id
        LEFT JOIN products p ON oi.product_id = p.id
        WHERE o.id = #{id}
        ORDER BY oi.id
    </select>

    <!-- ================================================================ -->
    <!-- 嵌套查询 (Nested Select) — N+1 问题演示                           -->
    <!-- ================================================================ -->
    <resultMap id="orderNestedSelect" type="com.example.order.model.Order" extends="orderBase">
        <!--
            不用 JOIN，改为两次独立查询：
            1. selectOrderNestedSelect 查 Order，拿到 user_id
            2. 用 user_id 调 selectUserById 查 User
            查 N 个 Order = 1 + N 条 SQL = N+1 问题
        -->
        <association property="user" javaType="com.example.order.model.User"
                     column="user_id" select="selectUserById"/>
    </resultMap>

    <select id="selectOrderNestedSelect" resultMap="orderNestedSelect">
        SELECT id, user_id, order_no, total_amount, status, created_at
        FROM orders
        WHERE id = #{id}
    </select>

    <select id="selectUserById" resultType="com.example.order.model.User">
        SELECT id, username, email, phone, created_at
        FROM users
        WHERE id = #{id}
    </select>

    <!-- ================================================================ -->
    <!-- 存储过程调用: statementType="CALLABLE"                            -->
    <!-- PG 的 procedure 用原生 CALL 语法，不用 JDBC 转义花括号             -->
    <!-- ================================================================ -->
    <update id="callUpdateOrderStatus" statementType="CALLABLE">
        CALL sp_update_order_status(#{orderId, mode=IN, jdbcType=BIGINT},
                                     #{newStatus, mode=IN, jdbcType=VARCHAR})
    </update>

    <!-- ===== FOR UPDATE: 悲观锁，读取时锁行 ===== -->
    <select id="selectForUpdate" resultType="com.example.order.model.Order">
        SELECT <include refid="orderColumns"/>
        FROM orders o
        WHERE o.id = #{id}
        FOR UPDATE
    </select>

</mapper>
