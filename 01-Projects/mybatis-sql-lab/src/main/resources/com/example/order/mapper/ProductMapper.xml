<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.order.mapper.ProductMapper">

    <select id="selectById" resultType="com.example.order.model.Product">
        SELECT id, name, price, stock, category
        FROM products
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultType="com.example.order.model.Product">
        SELECT id, name, price, stock, category FROM products
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO products (name, price, stock, category)
        VALUES (#{name}, #{price}, #{stock}, #{category})
    </insert>

    <update id="update">
        UPDATE products
        SET name = #{name}, price = #{price}, stock = #{stock}, category = #{category}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM products WHERE id = #{id}
    </delete>

    <!-- Phase 2: <sql> + <include> + <where> + <choose> 安全排序 -->
    <sql id="productColumns">
        id, name, price, stock, category
    </sql>

    <select id="selectByCondition" resultType="com.example.order.model.Product">
        SELECT <include refid="productColumns"/>
        FROM products
        <where>
            <if test="name != null and name != ''">
                <bind name="namePattern" value="'%' + name + '%'"/>
                AND name LIKE #{namePattern}
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="minPrice != null">
                AND price &gt;= #{minPrice}
            </if>
            <if test="maxPrice != null">
                AND price &lt;= #{maxPrice}
            </if>
        </where>
        <if test="orderBy != null">
            <!-- 用 choose 做白名单校验，防止 SQL 注入 -->
            ORDER BY
            <choose>
                <when test="orderBy == 'price'">price</when>
                <when test="orderBy == 'price_desc'">price DESC</when>
                <when test="orderBy == 'name'">name</when>
                <when test="orderBy == 'stock'">stock</when>
                <otherwise>id</otherwise>
            </choose>
        </if>
    </select>

</mapper>
